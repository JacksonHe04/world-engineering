# 本站（iNon 产品应用）的公开 origin
INON_SSO_PUBLIC_ORIGIN=https://world.inon.space
# 中央 SSO 身份平台的 origin（代理转发与 OAuth issuer）
INON_SSO_CANONICAL_ORIGIN=https://sso.inon.space
NEXT_PUBLIC_INON_TURNSTILE_SITE_KEY=

# iNon 作为中央 SSO 的首方项目 Client（仅服务端）
